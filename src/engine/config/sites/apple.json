{
  "ats": "Apple",
  "urls": [
    "*://jobs.apple.com/app/*/apply/*"
  ],
  "urlsExcluded": [],
  "embeddedPaths": [],
  "pathsExcluded": [],
  "containerPath": [],
  "containerRequired": false,
  "defaultMethod": "default",
  "submitButtonPaths": [],
  "submittedSuccessPaths": [],
  "trackedInputSelectors": [],
  "inputSelectors": [
    [
      "resume",
      [
        {
          "path": [
            "//section[@id='apply-resume-widgetwrapper']/section[contains(concat(' ',normalize-space(@class),' '),' resume-attachment-container ')]"
          ],
          "actions": [
            {
              "path": "%INPUTPATH%//button[@id='resume-remove']",
              "method": "click",
              "allowFailure": true,
              "condition": "%INPUTPATH%[.//button[@id='resume-remove']][.//p[starts-with(normalize-space(.),'Uploaded:')][number(substring(substring-after(normalize-space(substring-after(.,':')),', '),1,4))*10000 + number(substring(substring-after('Jan01Feb02Mar03Apr04May05Jun06Jul07Aug08Sep09Oct10Nov11Dec12',substring(normalize-space(substring-after(.,':')),1,3)),1,2))*100 + number(substring-before(substring-after(normalize-space(substring-after(.,':')),' '),',')) < %TODAY%]]"
            },
            {
              "path": "%INPUTPATH%//input[@type='file']",
              "method": "uploadResume",
              "time": 5000,
              "condition": "%INPUTPATH%[not(.//button[@id='resume-remove'])]"
            }
          ]
        }
      ]
    ],
    [
      "linkedin",
      [
        {
          "path": [
            "//section[@id='apply-resume-widgetwrapper']/section[contains(concat(' ',normalize-space(@class),' '),' linkedin-attachment-container ')]"
          ],
          "actions": [
            {
              "path": "%INPUTPATH%//button[@id='linkedin-remove']",
              "method": "click",
              "allowFailure": true,
              "condition": "%INPUTPATH%[.//p[@id='linkedin-url'][substring-before(concat(substring-after('%LOWERVALUE%','/in/'),'/'),'/') != ''][substring-before(concat(substring-after(translate(normalize-space(.),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz'),'/in/'),'/'),'/') != substring-before(concat(substring-after('%LOWERVALUE%','/in/'),'/'),'/')]]"
            }
          ]
        }
      ]
    ],
    [
      "language",
      [
        {
          "array": true,
          "addButtonPath": "//button[starts-with(@id,'parsedmodal-add-language-')]",
          "containerPath": "//fieldset[normalize-space(legend)='Edit Languages Spoken %NUMBER0%']",
          "confirmAddedPath": [
            "//fieldset[normalize-space(legend)='Edit Languages Spoken %NUMBER0%']"
          ],
          "time": 3000,
          "inputSelectors": [
            [
              "language",
              [
                {
                  "path": ".//select[starts-with(@id,'parsedmodal-language-')]",
                  "method": "default"
                }
              ]
            ],
            [
              "level",
              [
                {
                  "path": ".//select[starts-with(@id,'parsedmodal-spokenlanguages-')]",
                  "method": "default"
                }
              ]
            ]
          ]
        }
      ]
    ]
  ]
}
